{
  "name": "gdc-cas",
  "version": "0.1.0",
  "description": "Node.js client library for Google Distributed Cloud air-gapped Certificate Authority Service (CAS)",
  "main": "index.js",
  "type": "module",
  "types": "cas-client.d.ts",
  "exports": {
    ".": {
      "types": "./cas-client.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "cas-client.js",
    "cas-client.d.ts",
    "sts-auth.js",
    "proto/cas-json.js",
    "proto/cas.proto",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleCloudPlatform/google-distributed-cloud-node.git",
    "directory": "cas/gdc-cas"
  },
  "homepage": "https://github.com/GoogleCloudPlatform/google-distributed-cloud-node/tree/main/cas/gdc-cas#readme",
  "bugs": {
    "url": "https://github.com/GoogleCloudPlatform/google-distributed-cloud-node/issues"
  },
  "keywords": [
    "gdc",
    "google-distributed-cloud",
    "cas",
    "certificate-authority-service",
    "pki",
    "certificate"
  ],
  "author": "Google LLC",
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@kubernetes/client-node": "^1.2.0",
    "axios": "^1.9.0",
    "jsonwebtoken": "^9.0.2",
    "protobufjs": "^8.8.0"
  },
  "scripts": {
    "test": "node --test",
    "check:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext cas-client.d.ts",
    "build:proto": "pbjs -t json-module -w es6 --keep-case proto/cas.proto | awk 'BEGIN{while((getline line < \"proto/cas.proto\")>0 && line ~ /^\\/\\//) print line; print \"\"} {print}' > proto/cas-json.js"
  },
  "devDependencies": {
    "protobufjs-cli": "^2.6.2",
    "typescript": "^5.7.2"
  }
}
